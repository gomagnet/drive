[Unit]
Description=Magnet Drive
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
User=magnetdrive
Group=magnetdrive
WorkingDirectory=/opt/magnetdrive
Environment=MAGNETDRIVE_CONFIG=/etc/magnetdrive/magnetdrive.yaml
ExecStart=/opt/magnetdrive/MagnetDrive
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/magnetdrive
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
